# The SUB/WAVE station this player tunes into.
#
# Leave this unset to use the live public station (https://www.getsubwave.com).
# Point it at your own install to tune into your station:
#
#   VITE_STATION_URL=http://localhost:7700
#   VITE_STATION_URL=https://radio.example.com
#
# From this one origin the player derives ${url}/api and ${url}/stream.mp3.
# VITE_STATION_URL=https://www.getsubwave.com
